# ==========================================
# NorthStar Product Search — Root .gitignore
# ==========================================

# Python Virtual Environments
venv/
.venv/
env/
.env/
ENV/
venv.bak/
env.bak/
*/venv/
*/.venv/

# Python Cache & Byte-code
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
.cache/

# Environment Secrets
.env
.env.local
.env.*.local
*.env
!.env.example

# Node & Frontend Build Outputs
node_modules/
dist/
dist-ssr/
build/
.output/
.nitro/
.tanstack/
.vinxi/
.wrangler/
.dev.vars

# Large ML Model Cache Directories (Keep directory structure via .gitkeep)
backend/models/*
!backend/models/.gitkeep

# Logs & Temporary Files
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
*.temp

# IDE & Operating System Files
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
